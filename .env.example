# Public, read-only resource URL used by the web and packaged desktop apps.
# Example: https://assets.example.com/sylunae
MAIN_VITE_RESOURCE_PUBLIC_BASE_URL=

# Development-side upload credentials. These are never read by the app and
# must only be placed in .env.local, which is ignored by Git.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
