{
  "name": "siyue-workshop",
  "version": "0.1.0",
  "private": true,
  "description": "丝月工坊 - 个人桌面工具总站",
  "main": "out/main/index.js",
  "author": "Siyue Workshop",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:desktop": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "build:web": "npm run typecheck && vite build",
    "build:desktop": "npm run typecheck && electron-vite build",
    "package:win": "npm run build:desktop && electron-builder --win nsis"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "music-metadata": "latest"
  },
  "devDependencies": {
    "@tiptap/extension-image": "latest",
    "@tiptap/extension-link": "latest",
    "@tiptap/extension-placeholder": "latest",
    "@tiptap/extension-task-item": "latest",
    "@tiptap/extension-task-list": "latest",
    "@tiptap/react": "latest",
    "@tiptap/starter-kit": "latest",
    "dexie": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^41.10.3",
    "electron-builder": "latest",
    "electron-vite": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "^7.3.6",
    "vitest": "latest"
  },
  "build": {
    "appId": "studio.siyue.workshop",
    "productName": "丝月工坊",
    "electronVersion": "41.10.3",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Siyue-Workshop-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
